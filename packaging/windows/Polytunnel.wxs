<?xml version="1.0" encoding="utf-8"?>
<!--
  Polytunnel MSI (WiX Toolset 5). Build (packaging/build.sh does this):

    dotnet tool restore
    dotnet wix build packaging/windows/Polytunnel.wxs packaging/windows/ui.wxs -arch x64 ^
      -d Version=0.1.0 -d BinDir=target/release -d WintunDll=path/to/wintun.dll ^
      -d WintunLicense=path/to/wintun/LICENSE.txt ^
      -d NoticesFile=THIRD-PARTY-NOTICES.txt -o dist/polytunnel-0.1.0-windows-x64.msi

  Per-machine install into Program Files, the Polytunnel service (LocalSystem, started at
  boot), a Start menu shortcut, and clean major upgrades (the old service is removed before
  the new one is installed). ui.wxs is the setup wizard.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Polytunnel"
           Manufacturer="Polytunnel contributors"
           Version="$(var.Version)"
           UpgradeCode="67804223-D7CD-4334-BA9F-E497E61DC06C"
           Scope="perMachine"
           Language="1033"
           Codepage="1252"
           Compressed="yes">
    <!-- IgnoreLanguage: versions up to 0.0.12 were language-neutral (0); without it the
         Upgrade table would look only for language 1033 and miss them. -->
    <MajorUpgrade Schedule="afterInstallInitialize" IgnoreLanguage="yes"
                  DowngradeErrorMessage="A newer version of Polytunnel is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="PolytunnelIcon" SourceFile="assets/polytunnel.ico" />
    <Property Id="ARPPRODUCTICON" Value="PolytunnelIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/viru185/Polytunnel" />
    <Property Id="ARPHELPLINK" Value="https://github.com/viru185/Polytunnel/issues" />
    <!-- No Modify button in Apps (there are no features to change); opening the MSI again
         offers Repair or Remove. -->
    <Property Id="ARPNOMODIFY" Value="1" />

    <UIRef Id="PolytunnelUI" />

    <!-- Uninstalling (not upgrading) also stops the tray starting at sign-in: deletes the
         uninstalling user's HKCU Run value, which the app or the Finish page wrote. -->
    <CustomAction Id="AutostartOff" Directory="INSTALLFOLDER"
                  ExeCommand="&quot;[INSTALLFOLDER]polytunnelw.exe&quot; autostart off"
                  Execute="deferred" Impersonate="yes" Return="ignore" />
    <InstallExecuteSequence>
      <Custom Action="AutostartOff" Before="RemoveFiles"
              Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
    </InstallExecuteSequence>

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="Polytunnel" />
    </StandardDirectory>

    <Feature Id="Main" Title="Polytunnel" AllowAbsent="no">
      <Component Id="App" Directory="INSTALLFOLDER">
        <File Id="PolytunnelExe" Source="$(var.BinDir)/polytunnel.exe" KeyPath="yes" />
      </Component>

      <!-- The window and tray without a console window (Start menu, sign-in, tray). -->
      <Component Id="AppWindowed" Directory="INSTALLFOLDER">
        <File Id="PolytunnelwExe" Source="$(var.BinDir)/polytunnelw.exe" KeyPath="yes" />
      </Component>

      <Component Id="Daemon" Directory="INSTALLFOLDER">
        <File Id="DaemonExe" Source="$(var.BinDir)/polytunnel-daemon.exe" KeyPath="yes" />
        <ServiceInstall Id="PolytunnelService"
                        Name="Polytunnel"
                        DisplayName="Polytunnel VPN service"
                        Description="Creates Polytunnel's VPN tunnels and network settings for the Polytunnel app."
                        Type="ownProcess"
                        Start="auto"
                        ErrorControl="normal"
                        Account="LocalSystem"
                        Arguments="run --service"
                        Vital="yes" />
        <ServiceControl Id="PolytunnelServiceControl"
                        Name="Polytunnel"
                        Start="install"
                        Stop="both"
                        Remove="uninstall"
                        Wait="yes" />
      </Component>

      <Component Id="Sso" Directory="INSTALLFOLDER">
        <File Id="SsoExe" Source="$(var.BinDir)/polytunnel-sso.exe" KeyPath="yes" />
      </Component>

      <Component Id="Wintun" Directory="INSTALLFOLDER">
        <File Id="WintunDll" Name="wintun.dll" Source="$(var.WintunDll)" KeyPath="yes" />
      </Component>

      <Component Id="WintunLicense" Directory="INSTALLFOLDER">
        <File Id="WintunLicense" Name="wintun-LICENSE.txt" Source="$(var.WintunLicense)" KeyPath="yes" />
      </Component>
      <Component Id="License" Directory="INSTALLFOLDER">
        <File Id="License" Name="LICENSE.txt" Source="LICENSE" KeyPath="yes" />
      </Component>
      <Component Id="Notices" Directory="INSTALLFOLDER">
        <File Id="Notices" Name="THIRD-PARTY-NOTICES.txt" Source="$(var.NoticesFile)" KeyPath="yes" />
      </Component>

      <Component Id="StartMenu" Directory="ProgramMenuFolder">
        <Shortcut Id="StartMenuShortcut"
                  Name="Polytunnel"
                  Description="Lightweight VPN client for GlobalProtect and Fortinet"
                  Target="[INSTALLFOLDER]polytunnelw.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="PolytunnelIcon" />
        <RegistryValue Root="HKLM" Key="Software\Polytunnel" Name="StartMenuShortcut"
                       Type="integer" Value="1" KeyPath="yes" />
      </Component>

      <!-- `polytunnel status`, `polytunnel killswitch`, ... in any new terminal; removed on
           uninstall. -->
      <Component Id="PathEntry" Directory="INSTALLFOLDER">
        <Environment Id="PathEntry" Name="PATH" Value="[INSTALLFOLDER]" Action="set" Part="last"
                     System="yes" Permanent="no" />
        <RegistryValue Root="HKLM" Key="Software\Polytunnel" Name="PathEntry"
                       Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </Feature>
  </Package>
</Wix>
